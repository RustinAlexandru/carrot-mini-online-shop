{
  "info": {
    "_postman_id": "5b0b6c1e-3c1d-4a8e-9a8e-2f6f1d6c0a11",
    "name": "Mini Online Shop",
    "description": "Browse the Mini Online Shop API. Start the stack with `docker compose up --build`, then run **Auth \u203a Log in** first (or use Run collection to walk the whole flow; every request has tests).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": "demo@shop.test"
    },
    {
      "key": "password",
      "value": "DemoShop123!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId1",
      "value": ""
    },
    {
      "key": "productId2",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in as the seeded user and stores the JWT in the `token` collection variable. Run this first; tokens last 60 minutes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"returns a token\", () => pm.expect(body.token).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"token\", body.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products (paged, sorted)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&pageSize=5&sortBy=price&sortDirection=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "5"
                },
                {
                  "key": "sortBy",
                  "value": "price"
                },
                {
                  "key": "sortDirection",
                  "value": "desc"
                }
              ]
            },
            "description": "Public. page >= 1, pageSize 1-50, sortBy name|price|createdAt, sortDirection asc|desc. Stores the first two product ids for the order requests.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has paging metadata\", () => pm.expect(body).to.include.keys(\"items\", \"page\", \"pageSize\", \"totalCount\", \"totalPages\"));",
                  "pm.test(\"sorted by price, highest first\", () => { const p = body.items.map(i => i.price); pm.expect(p).to.eql([...p].sort((a, b) => b - a)); });",
                  "pm.collectionVariables.set(\"productId1\", body.items[0].id);",
                  "pm.collectionVariables.set(\"productId2\", body.items[1].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "description": "All order routes require the bearer token (inherited from the collection). Run in order: Create stores `orderId` for the others.",
      "item": [
        {
          "name": "Create order (SAVE5)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Prices come from the server; the client sends only product ids, quantities and an optional coupon code.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId1}}\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"{{productId2}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"couponCode\": \"SAVE5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const money = (v) => Math.round(v * 100);",
                  "const body = pm.response.json();",
                  "pm.test(\"has a Location header\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.test(\"is a Draft with two lines and SAVE5\", () => { pm.expect(body.status).to.eql(\"Draft\"); pm.expect(body.items).to.have.length(2); pm.expect(body.coupon.code).to.eql(\"SAVE5\"); });",
                  "pm.test(\"total = subtotal - discount\", () => pm.expect(money(body.total)).to.eql(money(body.subtotal) - money(body.discount)));",
                  "pm.collectionVariables.set(\"orderId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Returns the saved price snapshots and computed totals. Another user's order (or a missing one) is 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"is the created order\", () => pm.expect(body.id).to.eql(pm.collectionVariables.get(\"orderId\")));",
                  "pm.test(\"has items and totals\", () => { pm.expect(body.items).to.have.length(2); pm.expect(body).to.include.keys(\"subtotal\", \"discount\", \"total\", \"currency\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace order (coupon removed)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Whole-state replacement: lines not listed are removed. `couponCode` must be present; null removes the coupon.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId1}}\",\n      \"quantity\": 3\n    }\n  ],\n  \"couponCode\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"one line with quantity 3\", () => { pm.expect(body.items).to.have.length(1); pm.expect(body.items[0].quantity).to.eql(3); });",
                  "pm.test(\"coupon removed, no discount\", () => { pm.expect(body.coupon).to.be.null; pm.expect(body.discount).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete order",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Hard delete; 204 No Content."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted order (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "The order is gone."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Failure examples",
      "item": [
        {
          "name": "Quantity 0 (400 with field error)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Validation errors return Problem Details with an `errors` map keyed by field.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId1}}\",\n      \"quantity\": 0\n    }\n  ],\n  \"couponCode\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"field error for items[0].quantity\", () => pm.expect(pm.response.json().errors).to.have.property(\"items[0].quantity\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Order without a token (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Every order route requires a valid bearer token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId1}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"couponCode\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unparseable page (generic 400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "abc"
                }
              ]
            },
            "description": "Request-parsing failures are a generic 400 Problem Details without an `errors` map.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"no field-error map\", () => pm.expect(pm.response.json()).to.not.have.property(\"errors\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Replace without couponCode (400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "00000000-0000-0000-0000-000000000000"
              ]
            },
            "description": "`couponCode` is required on PUT (send null to remove a coupon); a missing member fails binding.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId1}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
