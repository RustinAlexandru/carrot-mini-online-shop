{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MiniShop",
    "Audience": "MiniShop.Web",
    "Lifetime": "01:00:00"
  },
  "DraftSweeper": {
    "Enabled": true,
    "Interval": "00:01:00",
    "DraftTtl": "00:30:00"
  }
}
